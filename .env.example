# ===========================================================================
#  NEVER COMMIT THE FILLED-IN .env — IT HOLDS YOUR BOT TOKEN
#  This file (.env.example) is the template and is safe to commit.
#  Copy it:  cp .env.example .env
# ===========================================================================

# ============================================================================
#  REQUIRED
# ============================================================================

# Bot token from @BotFather
BOT_TOKEN=1234567890:AAxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Admin Telegram IDs, comma-separated. Get yours from @userinfobot
ADMIN_IDS=123456789

# ============================================================================
#  OPTIONAL
# ============================================================================

# Group/channel where new orders are posted.
# Leave empty to send orders privately to every admin instead.
# The bot must be an administrator of that chat. Example: -1001234567890
ORDERS_CHAT_ID=

# ---------------------------------------------------------------------------
#  PAYMENT METHODS
# ---------------------------------------------------------------------------
# Which methods to show, comma-separated. Leave empty to show all of them.
# Available: payme, click, card_uz, sbp, sber, yoomoney, stars, cash
# Selling only inside Uzbekistan? PAYMENT_METHODS=payme,click,card_uz,cash
PAYMENT_METHODS=

# --- Telegram Payments tokens (@BotFather -> /mybots -> Payments)
# Each requires a merchant account. Without a token the button still appears and
# walks the customer through the live flow, clearly marked as a demo.
PAYME_TOKEN=
CLICK_TOKEN=
YOOMONEY_TOKEN=

# Legacy single-provider token, still honoured if you use only one provider.
PAYMENT_PROVIDER_TOKEN=

# --- Bank transfer requisites (work today, no merchant account)
# The customer transfers, sends a photo of the receipt, an admin approves it.
# Placeholders are used when these are empty, so the demo screen is never blank.
CARD_UZ_NUMBER=
CARD_UZ_HOLDER=
CARD_UZ_BANK=

SBP_PHONE=
SBP_HOLDER=
SBP_BANK=

SBER_CARD=
SBER_HOLDER=
SBER_BANK=

# Telegram Stars: no merchant account, no provider token, works worldwide.
# This is what makes a public demo payable by anyone.
STARS_ENABLED=true

# demo | live
#   demo — a Stars invoice charges STARS_DEMO_AMOUNT and says so on screen, so
#          anyone can walk the full payment flow for a token amount
#   live — charges the real converted amount
PAYMENT_MODE=demo
STARS_DEMO_AMOUNT=1

# Retail price of one Star in USD. Telegram sells them at roughly $0.02.
STAR_PRICE_USD=0.02

# ISO currency code sent to Telegram Payments. Must match the accounting
# currency (UZS): Payme and Click settle in sums only, whatever the customer
# is browsing in.
CURRENCY=UZS

# Symbol for the BASE currency next to prices.
# LEAVE EMPTY to let each language use its own (сум / so'm).
# RUB (₽) and USD ($) take their symbols from the currency, not the language.
CURRENCY_SYMBOL=

# SQLite file path. Use an absolute path in Docker, e.g. /data/shop.db
DB_PATH=shop.db

# FSM storage: sqlite | memory
#   sqlite — default. State lives in the same database file, so a customer
#            halfway through checkout keeps their progress across a restart.
#   memory — faster, but unfinished flows are lost on restart.
FSM_STORAGE=sqlite

# Redis URL. Overrides FSM_STORAGE when set — the right choice under real
# concurrency. Example: redis://localhost:6379/0
REDIS_URL=

# Display timezone for all dates. Data is always stored in UTC.
TIMEZONE=Asia/Tashkent

# Interface language for new users and for admin notifications: uz | ru
# Each user can change their own language with /language at any time.
DEFAULT_LANG=ru

# Display currency for new users: UZS | RUB | USD
# Each user can change their own with /currency. Prices are always STORED in
# UZS — the other currencies are a display layer driven by the exchange rate.
DEFAULT_CURRENCY=UZS

# Minimum seconds between two actions from the same user (anti-spam).
THROTTLE_RATE=0.5

# How many unfinished (unpaid, unclosed) orders one account may pile up.
# Stops a publicly reachable demo from being filled by clicking.
MAX_OPEN_ORDERS=10

# DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO
LOG_DIR=logs

# ============================================================================
#  WEBHOOK MODE (leave USE_WEBHOOK=false for polling)
# ============================================================================

USE_WEBHOOK=false

# Public HTTPS URL of the server, no trailing slash. Example: https://bot.example.com
WEBHOOK_BASE_URL=

# Random secret, 32+ characters. Telegram sends it back in every request and
# the bot verifies it. Generate: openssl rand -hex 24
WEBHOOK_SECRET=

# Optional custom path. Derived from WEBHOOK_SECRET when empty.
WEBHOOK_PATH=

WEBHOOK_HOST=0.0.0.0
PORT=8080
